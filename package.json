{
  "name": "mini-paste",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "build:app": "tauri build --bundles app && bash scripts/sign-macos.sh",
